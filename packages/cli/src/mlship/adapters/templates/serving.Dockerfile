# Generated by mlship: one image per model version (ADR-007, ADR-020).
# The base is the exact environment the model was trained in; only the verified
# model files and the platform's load policy are added on top.
FROM ${base_image}
COPY --chown=0:0 model/ /opt/mlship/model/
ENV MLSHIP_SERVING_MODEL_DIR=/opt/mlship/model \
    MLSHIP_SERVING_MODEL_NAME=${model_name} \
    MLSHIP_SERVING_MODEL_VERSION=${model_version} \
    MLSHIP_SERVING_MODEL_SHA256=${model_sha256} \
    MLSHIP_SERVING_ALLOW_PICKLE=${allow_pickle} \
    MLSHIP_SERVING_SKOPS_TRUSTED_TYPES='${skops_trusted_types}'
EXPOSE 8080
ENTRYPOINT ["python", "-m", "mlship_runtime.serving"]
CMD ["--port", "8080", "--workers", "1"]
