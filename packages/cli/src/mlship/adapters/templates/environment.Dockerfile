# Generated by mlship from a template. Any change here changes the environment key.
# Build stage: install the locked dependencies into a virtualenv.
FROM ${base_image} AS build
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
COPY requirements.lock /tmp/requirements.lock
COPY wheels/ /tmp/wheels/
# --require-hashes: every artifact must match the hash in the lock.
# --only-binary: wheels only; building an sdist would run third-party code.
# --no-deps: the lock is complete; nothing outside it gets installed.
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --require-hashes --only-binary=:all: --no-deps \
      -r /tmp/requirements.lock \
 && /opt/venv/bin/pip install --no-index --no-deps /tmp/wheels/*.whl \
 && /opt/venv/bin/pip uninstall --yes pip

# Final stage: same base, the virtualenv, a non-root user. No build tools.
FROM ${base_image}
# The base image ships pip globally; the final image installs nothing at runtime.
RUN python -m pip uninstall --yes pip \
 && useradd --uid 10001 --create-home --shell /usr/sbin/nologin mlship
COPY --from=build /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MLFLOW_DISABLE_AGENT_HINT=1
USER 10001:10001
WORKDIR /home/mlship
